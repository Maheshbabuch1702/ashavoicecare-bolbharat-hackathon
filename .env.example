# ---------------------------------------------------------------------------
# ASHA VoiceCare - environment template
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ---------------------------------------------------------------------------

# Gnani Speech APIs (https://app.gnani.ai/voice/)
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# LLM extraction (optional). When empty the deterministic rule extractor is used.
# Any OpenAI-compatible endpoint works.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# storage
DATABASE_PATH=./data/asha.db

# CORS origin of the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
